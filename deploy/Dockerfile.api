FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
# Optional faster mirror for restricted networks; defaults to official PyPI.
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" .

COPY alembic.ini ./
COPY alembic ./alembic
COPY scripts ./scripts
COPY samples ./samples
COPY deploy/start-api.sh /usr/local/bin/start-api.sh

RUN sed -i 's/\r$//' /usr/local/bin/start-api.sh \
    && chmod +x /usr/local/bin/start-api.sh \
    && useradd --create-home --shell /bin/bash edumate \
    && mkdir -p /app/data/uploads \
    && chown -R edumate:edumate /app

USER edumate

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/live', timeout=3)"

CMD ["/usr/local/bin/start-api.sh"]
