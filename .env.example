# ---------------------------------------------------------------------------
# EduMate local development environment
# Copy to .env and fill values. Never commit the real .env.
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=EduMate
API_PREFIX=/api/v1
LOG_LEVEL=INFO
SECRET_KEY=please-change-me-to-a-random-32-plus-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS used by docker compose web (port 8080)
CORS_ORIGINS_DOCKER=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Database: host development uses mapped port 3307; compose overrides host to mysql:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=edumate
MYSQL_PASSWORD=edumate_dev_password
MYSQL_DATABASE=edumate
# Optional explicit override; leave empty to assemble from MYSQL_* above.
DATABASE_URL=

# Redis (optional cache; failures degrade gracefully)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# RAG service (ZhiYuan_EduMind) - local host mapping is 18000 on this machine;
# inside Docker Compose use http://host.docker.internal:18000
RAG_BASE_URL=http://127.0.0.1:18000
# Inside docker compose the API reaches the host-mapped RAG port:
RAG_BASE_URL_DOCKER=http://host.docker.internal:18000
RAG_API_KEY=
RAG_TIMEOUT_SECONDS=300
RAG_CONNECT_TIMEOUT_SECONDS=10
RAG_MAX_RETRIES=1
RAG_HEALTH_TIMEOUT_SECONDS=3

# Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=200
# Auto-approve submissions that pass the safety rules; others stay pending.
AUTO_REVIEW_ENABLED=true

# Optional pip mirror used only while building the API image.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Demo seed password (development only)
SEED_DEMO_PASSWORD=EduMate@2026
